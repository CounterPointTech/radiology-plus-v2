# Environment for the shared reverse proxy (compose.proxy.yaml). One proxy serves every
# stack on the host, so this file names all of them.
#
# Upstreams are container names on the radplus-edge network. They carry the compose
# project prefix, so the test stack's API is radplus-test-api-1.

# --- hostnames --------------------------------------------------------------
# Caddy accepts a comma-separated list, so all three environments can share one proxy:
#   WEB_HOST=rp.example.com, rp-test.example.com, rp-dev.example.com
# but each hostname must route to its own stack, so in practice run one proxy project
# per environment (different project name, different env file) or extend the Caddyfile
# with one site block per environment.
WEB_HOST=rp-test.example.com
ADMIN_HOST=admin-rp-test.example.com

# --- upstreams --------------------------------------------------------------
API_UPSTREAM=radplus-test-api-1:5171
ADMINAPI_UPSTREAM=radplus-test-adminapi-1:5181
WEB_UPSTREAM=radplus-test-web-1:3000
ADMIN_UPSTREAM=radplus-test-admin-1:3000

# --- TLS --------------------------------------------------------------------
ACME_EMAIL=dan@counterpointtech.com
# Leave empty for real Let's Encrypt certificates. Set to `local_certs` for a private
# hostname or local testing, where a public CA cannot issue.
ACME_STAGING_DIRECTIVE=
# Only when WEB_HOST is a bare IP (no DNS): clients then send no SNI, so tell Caddy which
# certificate to serve by default. Example: default_sni 10.0.0.5
DEFAULT_SNI_DIRECTIVE=
# Purchased certificate instead of automatic issuance. Put cert.pem (full chain) and
# key.pem in /opt/radplus/certs and set:  tls /certs/cert.pem /certs/key.pem
# Convert a .pfx with:
#   openssl pkcs12 -in site.pfx -clcerts -nokeys -out certs/cert.pem   (then append the chain:
#   openssl pkcs12 -in site.pfx -cacerts -nokeys -chain >> certs/cert.pem)
#   openssl pkcs12 -in site.pfx -nocerts -nodes -out certs/key.pem && chmod 600 certs/key.pem
TLS_DIRECTIVE=

TZ=America/New_York
