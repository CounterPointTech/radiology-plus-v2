# Template for a stack's environment file. Copy, fill in, and keep the real one OUT of
# git — on the server they live at /opt/radplus/env/{dev,test,prod}.env, chmod 600 and
# root-owned. Every stack gets its own distinct secrets.
#
#   docker compose -p radplus-test --env-file /opt/radplus/env/test.env -f compose.yaml up -d
#
# Never run `docker compose config` into a log or a CI artifact: it interpolates these
# values in full.

# --- images -----------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/counterpointtech
# Always an immutable sha-<short> tag, never `latest` — this is also what makes a
# rollback just "deploy the previous tag".
TAG=dev

# --- database ---------------------------------------------------------------
POSTGRES_DB=rad_plus
POSTGRES_USER=postgres
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- secrets ----------------------------------------------------------------
# Base64 of exactly 32 random bytes:  openssl rand -base64 32
#
# This decrypts every per-tenant Novarad and M*Modal credential in tenancy.*. LOSING IT
# PERMANENTLY BRICKS THOSE ROWS — there is no key id in the ciphertext today, so they
# cannot be recovered or re-encrypted from anything but the plaintext passwords.
# Back it up separately from the database backups; if both live in one place, the
# encryption is decorative.
ENCRYPTION_KEY=

# openssl rand -base64 64 — at least 32 characters.
JWT_SECRET=

# --- origins ----------------------------------------------------------------
# Public URLs of the two front ends. Used for CORS, which uses AllowCredentials() and
# therefore cannot accept a wildcard.
WEB_ORIGIN=https://rp.example.com
ADMIN_ORIGIN=https://admin-rp.example.com

# --- behaviour --------------------------------------------------------------
TZ=America/New_York
LOG_LEVEL=Information

# .NET TimeSpan (d.hh:mm:ss). The worklist projector's own default is 7 days, on which
# it projects nothing and then prunes the whole worklist within four hours. Leave this
# generous.
TECH_LOOKBACK_WINDOW=120.00:00:00
